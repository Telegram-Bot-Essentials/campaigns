{
    "name": "telegram-bot-essentials/campaigns",
    "description": "Tracked marketing campaign links, attribution and an admin menu for telegram-bot-essentials/essence",
    "type": "library",
    "require": {
        "php": "^8.3",
        "ext-gd": "*",
        "chillerlan/php-qrcode": "^6.0",
        "laravel/framework": "^12 || ^13",
        "telegram-bot-essentials/billing": "~0.0.32",
        "telegram-bot-essentials/essence": ">=0.13"
    },
    "suggest": {
        "telegram-bot-essentials/user-management": "Adds a campaign section and a campaign filter to the admin user list.",
        "telegram-bot-essentials/user-wallet": "Enables the wallet-credit prize and lets the revenue figures exclude wallet top-ups."
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TelegramBotEssentials\\Campaigns\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "authors": [
        {
            "name": "Elyar",
            "email": "elyareranjbar@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "TelegramBotEssentials\\Campaigns\\TbeCampaignsServiceProvider"
            ]
        }
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.7 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.1 || ^4.0",
        "telegram-bot-essentials/user-management": "~0.0.17",
        "telegram-bot-essentials/user-wallet": "~0.0.22"
    },
    "autoload-dev": {
        "psr-4": {
            "TelegramBotEssentials\\Campaigns\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    }
}
